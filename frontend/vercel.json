{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://message-u5oo.onrender.com/api/:path*"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "https://message-u5oo.onrender.com/webhooks/:path*"
    },
    {
      "source": "/((?!api/|webhooks/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
